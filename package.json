{
  "name": "chachoengsao-traffic-cameras",
  "version": "1.1.0",
  "private": true,
  "description": "Static public traffic camera viewer for Chachoengsao",
  "scripts": {
    "start": "node tools/serve.cjs",
    "detect:start": "node tools/detection.cjs start",
    "detect:stop": "node tools/detection.cjs stop",
    "detect:status": "node tools/detection.cjs status",
    "build": "node tools/build.cjs",
    "test": "node --test tests/core.test.cjs tests/player.test.cjs tests/packaging.test.cjs tests/camera-export.test.cjs tests/flood-core.test.cjs tests/flood-client.test.cjs tests/rain-core.test.cjs tests/rain-client.test.cjs",
    "test:flood-browser": "node tests/flood-browser.cjs",
    "test:rain-browser": "node tests/rain-browser.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:live": "node tests/live.cjs",
    "check": "node tools/check-syntax.cjs && npm test",
    "api": "python -m uvicorn backend.flood.api:app --host 127.0.0.1 --port 8100",
    "flood:api": "python -m uvicorn backend.flood.api:app --host 127.0.0.1 --port 8100",
    "flood:worker": "python -m backend.flood.worker",
    "rain:worker": "python -m backend.rain.worker"
  },
  "devDependencies": { "playwright": "1.63.0" },
  "engines": { "node": ">=20" }
}
